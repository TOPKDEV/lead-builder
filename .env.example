# Easiest: run `python leads.py keys` and paste your key into the page that
# opens. Or paste it after the = sign here. `python leads.py doctor` tells
# you whether it works.

# Monid (monid.ai): the one key. It runs every tool the lead builder uses
# (listings, phone checks, email checks, searching, homes.com) from one
# prepaid balance.
MONID_API_KEY=

# Twilio (optional): a carrier's answer on numbers no record knows. Both are
# on the front page of console.twilio.com, under Account Info.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# --- Optional: your actual prices, if your plan differs (dollars) ---
# PRICE_MONID_CALL=0.0012
# PRICE_ZILLOW_SEARCH=0.0008
# PRICE_REALTOR_CALL=0.0055
# PRICE_REALTOR_LISTING=0.00165
# PRICE_SKIP_TRACE=0.0077
# PRICE_ZILLOW_PROFILE=0.01
# PRICE_PEOPLE_LOOKUP=0.065
# PRICE_TWILIO_LINE=0.008
# PRICE_MONID_EMAIL_VERIFY=0.0066

# --- Optional: how many things run at once ---
# LISTING_WORKERS=8     # Realtor.com and Zillow searches
# EMAIL_WORKERS=8
# HEADLESS_WORKERS=3    # Chrome windows; 3 fit in 16 GB of memory
# LOOKUP_WORKERS=8
